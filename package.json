{
  "name": "jazz-sdk-demo-web",
  "version": "26.11.23",
  "description": "SaluteJazz SDK Demo App",
  "private": true,
  "scripts": {
    "start:web": "npm -w jazz-sdk-testapp-web run start",
    "start:desktop": "npm -w jazz-sdk-testapp-desktop run start",
    "clean": "rm -rf dist",
    "lint": "npm-run-all lint:*",
    "lint:eslint": "npm run eslint",
    "lint:tsc": "tsc --noEmit",
    "eslint": "eslint --cache --max-warnings 0 \"packages/*/{src,src-renderer,src-main,src-preload}/**/*.{ts,tsx}\" \"apps/*/{src,src-renderer,src-main,src-preload}/**/*.{ts,tsx}\"",
    "eslint-fix": "npm run eslint -- --fix",
    "version": "npm version $npm_package_version -w apps -w packages --no-git-tag-version --no-commit-hooks"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@salutejs/jazz-sdk-electron": "26.11.23",
    "@salutejs/jazz-sdk-electron-plugins": "26.11.23",
    "@salutejs/jazz-sdk-web": "26.11.23",
    "@salutejs/jazz-sdk-web-plugins": "26.11.23",
    "@salutejs/plasma-b2c": "1.602.0",
    "@salutejs/plasma-icons": "1.228.0",
    "@salutejs/plasma-themes": "0.39.0",
    "@salutejs/plasma-typo": "0.42.0",
    "@tanstack/react-virtual": "3.13.18",
    "@tanstack/virtual-core": "3.13.18",
    "electron": "38.7.2",
    "electron-log": "5.4.3",
    "electron-window-state": "^5.0.3",
    "lodash": "4.17.23",
    "nrgy": "0.0.46",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rxjs": "7.8.2",
    "styled-components": "5.3.11",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@babel/cli": "7.27.0",
    "@babel/core": "7.22.1",
    "@babel/eslint-parser": "7.27.0",
    "@babel/plugin-transform-runtime": "7.22.4",
    "@babel/preset-env": "7.22.4",
    "@babel/preset-react": "7.22.3",
    "@babel/preset-typescript": "7.27.0",
    "@babel/runtime": "7.22.6",
    "@eslint/compat": "1.2.7",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.2",
    "@svgr/webpack": "8.1.0",
    "@types/lodash": "4.17.23",
    "@types/node": "22.15.24",
    "@types/react": "^18.2.72",
    "@types/react-dom": "^18.2.22",
    "@types/styled-components": "5.1.29",
    "@types/uuid": "9.0.7",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "astroturf": "1.2.0",
    "babel-loader": "10.0.0",
    "babel-plugin-macros": "3.1.0",
    "case-sensitive-paths-webpack-plugin": "2.4.0",
    "copy-webpack-plugin": "13.0.1",
    "cross-env": "10.1.0",
    "css-loader": "7.1.3",
    "eslint": "9.23.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": " 2.31.0",
    "eslint-plugin-prettier": "5.2.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "html-webpack-plugin": "5.6.6",
    "mini-css-extract-plugin": "2.10.0",
    "npm-run-all2": "8.0.4",
    "postcss": "8.4.21",
    "postcss-flexbugs-fixes": "4.2.1",
    "postcss-import": "15.1.0",
    "postcss-loader": "7.1.0",
    "postcss-nested": "6.0.1",
    "postcss-normalize": "8.0.1",
    "postcss-preset-env": "8.3.0",
    "postcss-rem": "2.0.4",
    "postcss-url": "10.1.3",
    "style-loader": "3.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "webpack": "5.105.0",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.3"
  }
}
